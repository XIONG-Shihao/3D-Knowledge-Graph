# Native Linux runtime. This is NOT a Docker configuration.
KB_DATA_DIR=./data
KB_SEED_DEMO=true
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_EMBEDDING_MODEL=
# The pinned Python RAGFlow native profile supports these graph endpoints.
RAGFLOW_LEGACY_GRAPH_API=true
RAGFLOW_TIMEOUT_SECONDS=30
