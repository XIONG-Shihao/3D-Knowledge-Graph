# Local mode needs no credentials. Copy this file to .env to connect RAGFlow.
KB_DATA_DIR=./data
KB_SEED_DEMO=true
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
# Optional: embedding model configured on your RAGFlow server.
RAGFLOW_EMBEDDING_MODEL=
# Legacy graph endpoints are opt-in. New knowledge-compilation releases may
# require exporting a graph artifact and importing its JSON in the app instead.
RAGFLOW_LEGACY_GRAPH_API=false
RAGFLOW_TIMEOUT_SECONDS=30
